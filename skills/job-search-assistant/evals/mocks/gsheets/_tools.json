{
  "tools": [
    {
      "name": "get_spreadsheet",
      "description": "Returns titles, sheet names, sheet ids, the revisionId and other metadata for a spreadsheet; with includeGridData true, also the cell data for the given ranges (fields such as sheets.data.rowData.values.userEnteredValue).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string"
          },
          "includeGridData": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "spreadsheetId"
        ]
      }
    },
    {
      "name": "get_values",
      "description": "Returns a range of values from a spreadsheet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        },
        "required": [
          "spreadsheetId",
          "range"
        ]
      }
    },
    {
      "name": "update_values",
      "description": "Sets values in a range of a spreadsheet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string"
          },
          "range": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            }
          }
        },
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ]
      }
    },
    {
      "name": "insert_dimension",
      "description": "Inserts rows or columns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string"
          },
          "sheetId": {
            "type": "integer"
          },
          "dimension": {
            "type": "string"
          },
          "startIndex": {
            "type": "integer"
          },
          "endIndex": {
            "type": "integer"
          },
          "inheritFromBefore": {
            "type": "boolean"
          }
        },
        "required": [
          "spreadsheetId"
        ]
      }
    },
    {
      "name": "update_formulas",
      "description": "Sets formulas in a range of a spreadsheet (e.g. =HYPERLINK(...)).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string"
          },
          "range": {
            "type": "string"
          },
          "formulas": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            }
          }
        },
        "required": [
          "spreadsheetId",
          "range",
          "formulas"
        ]
      }
    },
    {
      "name": "update_spreadsheet",
      "description": "Applies one or more updates to the spreadsheet (spreadsheets.batchUpdate): addSheet, insertDimension, deleteDimension, updateCells, updateSheetProperties and the other batchUpdate requests, applied in order. writeControl.requiredRevisionId makes the whole batch fail if the spreadsheet changed since that revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string"
          },
          "requests": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "writeControl": {
            "type": "object",
            "properties": {
              "requiredRevisionId": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "spreadsheetId",
          "requests"
        ]
      }
    }
  ]
}
