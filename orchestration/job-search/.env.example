# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for scoring and tailoring
ANTHROPIC_API_KEY=
# Model used by the core LLM adapter (pin it so eval results stay comparable)
JOBS_MODEL=claude-sonnet-5-5

# Where personal data lives (all gitignored)
JOBS_DATA_DIR=./data
# Master resume as Markdown — the source of truth for scoring and tailoring
JOBS_MASTER_RESUME=./data/master_resume.md

# Google OAuth (see docs/setup/job-search-langgraph.md)
GOOGLE_CLIENT_SECRETS=./data/google/credentials.json
GOOGLE_TOKEN_PATH=./data/google/token.json

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=job-search
