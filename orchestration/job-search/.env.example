# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for scoring and tailoring
ANTHROPIC_API_KEY=
# Model used by the core LLM adapter (pin it so eval results stay comparable)
JOBS_MODEL=claude-sonnet-5-5

# Where personal data lives (all gitignored). Relative paths for JOBS_DATA_DIR and JOBS_PROFILE are
# taken from orchestration/job-search, whichever folder you run from, so the CLI and Studio share them.
JOBS_DATA_DIR=./data
# The job-search profile (the plugin's job-search-profile.md). Its "Full resume" line names the
# full resume, which must be in the same folder. Scoring also reads Target roles and Location.
# It also names the tracker (Tracker → Sheet ID); the pipeline reads it from here, never a copy.
# Point this at the profile in your Drive-synced job-search folder to share files with the plugin.
JOBS_PROFILE=./data/job-search-profile.md

# Google sign-in files live in $JOBS_DATA_DIR/google (setup guide, step 3).
# Where B keeps its jobs: sqlite (data/tracker.db, the default) or sheets (its shadow spreadsheet,
# created by `jobs auth google`).
JOBS_TRACKER=sqlite

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=job-search
